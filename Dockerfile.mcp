FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY common ./common
COPY mcp_backend ./mcp_backend

RUN pip install --no-cache-dir -e .

EXPOSE 8100

CMD ["python", "-m", "mcp_backend.server"]
